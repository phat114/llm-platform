# ============ AUTO MODEL SELECTION ============
# scripts/detect-gpu.sh sẽ tự dò VRAM của GPU và GHI ĐÈ các biến MODEL* bên dưới.
# Đặt false nếu muốn tự chọn model thủ công (giữ nguyên các giá trị bên dưới).
MODEL_AUTODETECT=true

# --- Các biến dưới đây do auto-detect ghi. Mặc định hợp RTX 3060 12GB. ---
MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
SERVED_MODEL_NAME=brain
QUANTIZATION=awq_marlin
MAX_MODEL_LEN=32768
TENSOR_PARALLEL_SIZE=1
TOOL_CALL_PARSER=hermes
# 3060 headless server: 0.90 OK. Nếu GPU này CŨNG chạy màn hình desktop, hạ 0.85.
GPU_MEMORY_UTILIZATION=0.90

# Cờ vLLM bổ sung tùy ý (vd: --enable-prefix-caching --disable-log-requests)
VLLM_EXTRA_ARGS=--enable-prefix-caching

# ============ AUTH / KEYS ============
# Key nội bộ giữa gateway <-> vLLM (chuỗi ngẫu nhiên bất kỳ)
VLLM_API_KEY=change-me-internal
# Master key của gateway — CLIENT/agent/app dùng key này để gọi API
LITELLM_MASTER_KEY=sk-change-me-please
# HuggingFace token — CHỈ cần cho model gated (vd Llama). Qwen KHÔNG cần.
HF_TOKEN=

# ============ GATEWAY DB + ADMIN UI ============
# Postgres cho LiteLLM. BẮT BUỘC nếu muốn login :4000/ui + phát virtual key.
# ĐỔI password, và giữ nó khớp giữa 2 dòng dưới.
POSTGRES_PASSWORD=change-me-db-password
# Host `postgres` = tên service trong docker-compose (DNS nội bộ của compose).
DATABASE_URL=postgresql://litellm:change-me-db-password@postgres:5432/litellm

# Tài khoản đăng nhập admin UI (:4000/ui). KHÁC với LITELLM_MASTER_KEY.
UI_USERNAME=admin
UI_PASSWORD=change-me-ui-password

# ============ HYBRID (model mạnh qua API ngoài — tùy chọn) ============
# Điền key để bật model "brain-pro" trong litellm.yaml (route task khó ra ngoài).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============ PORTS ============
VLLM_PORT=8000
LITELLM_PORT=4000
WEBUI_PORT=3000

# Bắt buộc đăng nhập cho Chat UI (Open WebUI)
WEBUI_AUTH=true

# ============ LAN ACCESS ============
# Hostname CỐ ĐỊNH để máy khác trong LAN gọi vào — dùng thay IP (IP thường là DHCP, sẽ đổi).
#   Windows : <COMPUTERNAME>.local   (mDNS có sẵn, không cần cài gì)
#   Linux   : <hostname>.local       (cần avahi-daemon: apt install avahi-daemon)
# Để trống/localhost nếu chỉ chạy 1 máy. Xem docs/lan-access.md.
LAN_HOST=localhost

# Địa chỉ bind cho service PUBLIC (Chat UI + Gateway). 0.0.0.0 = mọi interface (ra LAN).
# Đặt 127.0.0.1 để rút toàn bộ stack về localhost-only.
BIND_ADDR=0.0.0.0

# vLLM (engine thô) — giữ localhost. LAN đi qua gateway :4000 (có master key).
VLLM_BIND=127.0.0.1
